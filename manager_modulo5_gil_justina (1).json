    {
      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Envía una alerta por mail a un consultor humano para que contacte al cliente. Usala cuando el cliente pide hablar con una persona, pide precios o cotización, hace un reclamo, o la consulta queda fuera del ámbito comercial luego de una repregunta. No la uses para consultas que podés responder vos.",
        "sendTo": "justigil9@gmail.com",
        "subject": "=[HITL] Derivación a consultor - {{ $fromAI('motivo', 'Motivo breve de la derivación', 'string') }}",
        "emailType": "text",
        "message": "=El agente derivó una conversación a revisión humana.\n\nSession_ID: {{ $('Chat de entrada').first().json.sessionId }}\nDetalle: {{ $fromAI('detalle', 'Resumen de lo que pide el cliente y los datos de contacto que dio', 'string') }}\n\nAcción requerida: contactar al cliente.",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "15335603-8b89-43aa-8a68-7ee71bd05cf7",
      "name": "Derivar a consultor (HITL)",
      "type": "n8n-nodes-base.gmailTool",
      "typeVersion": 2.1,
      "position": [
        1620,
        560
      ],
      "webhookId": "0eac384a-6943-4449-b448-cd8a812bcb51"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "74b6d03a-b519-4c1d-8e32-45b9bc3dacde",
              "name": "mensajes_total",
              "value": "={{ $('Contexto unificado').first().json.mensajes_previos + 1 }}",
              "type": "number"
            },
            {
              "id": "b0a5850c-9178-44e6-9ae9-368a9df8a2f3",
              "name": "estado_nuevo",
              "value": "={{ ($('Agente Comercial (Manager)').first().json.intermediateSteps || []).map(s => s.action.tool).join(' ').includes('Derivar') ? 'Derivado a consultor' : (($('Agente Comercial (Manager)').first().json.intermediateSteps || []).map(s => s.action.tool).join(' ').includes('Registrar') && ($('Agente Comercial (Manager)').first().json.intermediateSteps || []).map(s => typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation)).join(' ').includes('success') ? 'Lead registrado' : ($('Contexto unificado').first().json.estado === 'Nuevo' ? 'En conversación' : $('Contexto unificado').first().json.estado)) }}",
              "type": "string"
            },
            {
              "id": "8f2f8a22-70c6-4cf8-81e6-62beb5f4e986",
              "name": "nombre",
              "value": "={{ (($('Agente Comercial (Manager)').first().json.intermediateSteps || []).map(s => typeof s.observation === 'string' ? s.observation : JSON.stringify(s.observation)).join(' ').match(/nombre\\\\?\"\\s*:\\s*\\\\?\"([^\"\\\\]+)/) || [])[1] || ($('Contexto unificado').first().json.user_name.startsWith('(') ? '' : $('Contexto unificado').first().json.user_name) }}",
              "type": "string"
            },
            {
              "id": "0bbe0d57-f22e-4c41-b718-e39b2dcec5a6",
              "name": "record_id",
              "value": "={{ $('Contexto unificado').first().json.record_id }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
