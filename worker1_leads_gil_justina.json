    {
      "parameters": {
        "text": "={{ $json.mensaje }}",
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"nombre\": {\n      \"type\": \"string\",\n      \"description\": \"Nombre y apellido. Vacío si no lo dijo\"\n    },\n    \"email\": {\n      \"type\": \"string\",\n      \"description\": \"Email de contacto. Vacío si no lo dijo\"\n    },\n    \"empresa\": {\n      \"type\": \"string\",\n      \"description\": \"Empresa. Vacío si no la dijo\"\n    },\n    \"necesidad\": {\n      \"type\": \"string\",\n      \"description\": \"Proceso o problema a resolver, en una oración\"\n    },\n    \"presupuesto\": {\n      \"type\": \"string\",\n      \"description\": \"Rango en USD o 'No informado'\"\n    },\n    \"rol_decision\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"Decide\",\n        \"Influye\",\n        \"Investiga\",\n        \"No informado\"\n      ]\n    },\n    \"plazo\": {\n      \"type\": \"string\",\n      \"description\": \"Plazo o 'No informado'\"\n    },\n    \"calificacion\": {\n      \"type\": \"string\",\n      \"enum\": [\n        \"CALIENTE\",\n        \"TIBIO\",\n        \"FRÍO\"\n      ]\n    },\n    \"resumen\": {\n      \"type\": \"string\",\n      \"description\": \"1 o 2 oraciones que justifican la calificación\"\n    },\n    \"faltantes\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"string\"\n      },\n      \"description\": \"Datos que faltan entre: nombre, email, empresa, necesidad, presupuesto, rol_decision, plazo\"\n    }\n  },\n  \"required\": [\n    \"nombre\",\n    \"email\",\n    \"empresa\",\n    \"necesidad\",\n    \"presupuesto\",\n    \"rol_decision\",\n    \"plazo\",\n    \"calificacion\",\n    \"resumen\",\n    \"faltantes\"\n  ]\n}",
        "options": {
          "systemPromptTemplate": "Sos un especialista en extracción de datos comerciales de Atlas Consultoría Digital. Extraé del mensaje del cliente SOLO los datos que estén explícitos; no inventes nada. Si un dato de contacto (nombre, email, empresa) no aparece, devolvé un texto vacío. Calificá con criterio BANT: CALIENTE = presupuesto definido, es quien decide, necesidad concreta y plazo menor a 3 meses; TIBIO = cumple dos o tres criterios; FRÍO = cumple uno o ninguno. Listá en 'faltantes' los datos que no fueron informados."
        }
      },
